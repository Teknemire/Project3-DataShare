{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --code-coverage",
    "test:e2e": "playwright test",
    "perf:browser": "node scripts/browser-metrics.mjs",
    "evidence:coverage": "node scripts/capture-coverage.mjs",
    "lint": "eslint . --max-warnings=0"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/forms": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@angular/router": "^20.3.33",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.38",
    "@angular/cli": "^20.3.39",
    "@angular/compiler-cli": "^20.3.33",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.1",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.5",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "piscina": "^5.3.2"
  }
}
