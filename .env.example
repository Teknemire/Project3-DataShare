# Copiez ce fichier en .env si la configuration locale doit etre recreee.
POSTGRES_DB=datashare
POSTGRES_USER=datashare
POSTGRES_PASSWORD=datashare
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=4200
FRONTEND_PUBLIC_URL=http://localhost:4200

# Remplacer cette valeur hors developpement (32 caracteres minimum).
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# local : les fichiers sont conserves dans backend/storage.
# s3 : renseigner S3_BUCKET, S3_REGION et les identifiants AWS ci-dessous.
STORAGE_TYPE=local
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Facultatif, seulement pour des identifiants AWS temporaires.
AWS_SESSION_TOKEN=

EXPIRATION_CLEANUP_DELAY_MS=900000
DOWNLOAD_TICKET_EXPIRATION=PT1M
# Duree maximale du transfert apres son demarrage (distincte du ticket).
DOWNLOAD_STREAM_TIMEOUT=3600s
